# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and must never be committed.

# MongoDB connection string (from MongoDB Atlas -> Connect -> Drivers)
# Tip: add a database name before the "?" e.g. .../bentota?retryWrites=true
MONGODB_URI=

# Secret used to sign admin login sessions. Use any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Vercel Blob storage token (Vercel dashboard -> Storage -> Blob -> create store -> .env.local tab)
BLOB_READ_WRITE_TOKEN=
